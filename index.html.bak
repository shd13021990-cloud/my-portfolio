        <!-- Form for Instant Brief -->
        <form class="contact-form-mild" id="mildContactForm">
          <input type="text" id="contactName" class="mild-input" placeholder="Your Name or Brand" required>
          <select id="contactService" class="mild-input" required>
            <option value="">Select Service Needed</option>
            <option value="Social Media Management & Growth">Social Media Management &amp; Viral Video</option>
            <option value="Digital Marketing & Ads">Digital Marketing &amp; Meta/Google Ads</option>
            <option value="Content Writing & Strategy">Content Writing &amp; Copywriting</option>
            <option value="Graphic Design & Branding">Graphic Design &amp; Brand Identity</option>
            <option value="Data Entry & Systems">Data Entry, Excel &amp; Systems</option>
            <option value="Full Monthly Freelance Retainer">Full Monthly Freelance Retainer</option>
          </select>
          <textarea id="contactMessage" class="mild-textarea" rows="4" placeholder="Briefly describe your brand goals or requirements..." required></textarea>
          <button type="submit" class="action-btn-pill primary" style="justify-content: center; cursor: pointer;">
            Send Direct to WhatsApp →
          </button>
        </form>
      </div>
    </div>
  </section>

