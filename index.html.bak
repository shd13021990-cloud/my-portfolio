<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Shahid Akram — Freelance Social Media Manager, Digital Marketer, Content Strategist, Graphic Designer & Data Systems Specialist. Inspired by Japanese digital craftsmanship.">
  <title>Shahid Akram | Freelance Social Media Manager & Digital Marketer</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- Floating Minimal Glow Cursor Dot -->
  <div class="p-stalker" id="stalker">
    <span class="stalker-dot"></span>
    <span class="stalker-text" id="stalkerText"></span>
  </div>

  <!-- Header -->
  <header class="l-header">
    <div class="l-header__inner">
      <div class="l-header__brand">
        <a href="#hero" class="l-header__logo u-en">
          <img src="21.png" alt="Shahid Akram Logo" class="l-header__logo-img">
          <span>Shahid Akram</span>
          <span class="logo-dot"></span>
        </a>
        <p class="l-header__tagline u-en">
          Social Media • Digital Marketing • Content • Design • Data Systems
        </p>
      </div>

      <div class="l-header__actions">
        <!-- Day / Night Time Toggle -->
        <button class="time-toggle-btn" id="timeToggleBtn" aria-label="Toggle Day / Night Mode">
          <span class="icon">☀️</span> Day
        </button>

        <!-- 3-Dot Floating Menu Button -->
        <button class="l-header__menu-button" id="menuBtn" aria-label="Open Menu">
          <div class="dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Dropdown Menu Drawer -->
    <div class="l-header__menu-drawer" id="menuDrawer">
      <nav class="l-header__nav-list">
        <a href="#hero"><span>01</span> Home</a>
        <a href="#cases"><span>02</span> Cases (1–5)</a>
        <a href="#disciplines"><span>03</span> Disciplines</a>
        <a href="#offer"><span>04</span> Offers &amp; Pricing</a>
        <a href="#gallery"><span>05</span> Creative Showcase</a>
        <a href="#experience"><span>06</span> Track Record</a>
        <a href="#tools"><span>07</span> AI Stack &amp; Tools</a>
        <a href="#contact"><span>08</span> Say “Hey!”</a>
      </nav>
      <div class="l-header__nav-sub">
        <span>Available for Remote &amp; Global Freelance</span>
        <span>Worldwide Client Retainers</span>
      </div>
    </div>
  </header>

  <!-- Main Hero Stage -->
  <section class="p-hero" id="hero">
    <div class="p-hero__container">

      <!-- Left: Interactive Isometric Room & Character Canvas -->
      <div class="p-hero__room" id="heroRoom">
        
        <!-- Day & Night Dynamic Hero Workspace Images -->
        <div class="hero-showcase-wrap">
          <img src="Main Image Day 1.png" alt="Shahid Akram Day Workspace" class="portfolio-image hero-showcase-img--day" id="heroImgDay">
          <img src="Main Image night.png" alt="Shahid Akram Night Workspace" class="portfolio-image hero-showcase-img--night" id="heroImgNight">
        </div>

        <div class="room-badge-bottom">
          <span class="status-dot-pulse"></span>
          <span>Open for Global Projects &amp; Freelance</span>
        </div>
      </div>

      <!-- Right: Playful Profile Intro -->
      <div class="p-hero__side">
        <h1 class="p-hero__hey u-en">
          Hey! <span class="hand-wave">🤝</span>
        </h1>
        <h2 class="p-hero__headline u-en">
          I’m a multi-disciplinary specialist creating <span>thoughtful strategies</span> &amp; high-impact digital results.
        </h2>
        <p class="p-hero__bio">
          Specializing in <strong>Social Media Management</strong>, <strong>Digital Marketing (ROAS)</strong>, <strong>Content Strategy &amp; Copywriting</strong>, <strong>Graphic Design</strong>, and <strong>Data Systems</strong>. Helping global brands, modern agencies, and e-commerce founders turn attention into revenue with creative craftsmanship and data precision.
        </p>

        <!-- Signature Mildsugar Action Buttons Row -->
        <div class="hero-actions-row">
          <a href="#cases" class="mildsugar-btn">
            <span class="label">
              <span class="label-text">Explore Cases (1–5)</span>
              <span class="label-text label-text--clone" aria-hidden="true">Explore Cases (1–5)</span>
            </span>
            <svg class="arrow-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M33.65 10.79L5.48 39.05C4.21 40.32 2.21 40.32 0.95 39.05C-0.32 37.78 -0.32 35.78 0.95 34.52L29.21 6.35H5.08C3.28 6.35 1.9 4.97 1.9 3.17C1.9 1.37 3.28 0 5.08 0H36.83C38.63 0 40 1.37 40 3.17V34.92C40 36.72 38.63 38.1 36.83 38.1C35.03 38.1 33.65 36.72 33.65 34.92V10.79Z" fill="#FEA831"/>
            </svg>
          </a>

          <a href="#contact" class="action-btn-pill secondary" style="padding: 14px 26px; font-size: 15px;">
            <span>Let’s Talk 🤝</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Marquee Ticker -->
  <div class="p-ticker">
    <div class="p-ticker__track">
      <div class="p-ticker__item"><span class="dot">✦</span> Social Media Strategy &amp; Viral Reels</div>
      <div class="p-ticker__item"><span class="dot">✦</span> High-Converting Content &amp; Copywriting</div>
      <div class="p-ticker__item"><span class="dot">✦</span> Visual Identity &amp; Graphic Design</div>
      <div class="p-ticker__item"><span class="dot">✦</span> Digital Marketing &amp; Meta Ads ROAS</div>
      <div class="p-ticker__item"><span class="dot">✦</span> 100% Precision Data Entry &amp; Automation</div>
      <div class="p-ticker__item"><span class="dot">✦</span> Social Media Strategy &amp; Viral Reels</div>
      <div class="p-ticker__item"><span class="dot">✦</span> High-Converting Content &amp; Copywriting</div>
      <div class="p-ticker__item"><span class="dot">✦</span> Visual Identity &amp; Graphic Design</div>
      <div class="p-ticker__item"><span class="dot">✦</span> Digital Marketing &amp; Meta Ads ROAS</div>
      <div class="p-ticker__item"><span class="dot">✦</span> 100% Precision Data Entry &amp; Automation</div>
    </div>
  </div>

  <!-- Full-Stage Cases Experience (mildsugardesign.jp /cases/ replica) -->
  <section class="p-cases-stage" id="cases">
    <!-- Huge Ghost Headline in Background -->
    <div class="p-cases__bg-text" aria-hidden="true">
      <div class="bg-ghost-quote" id="bgGhostQuote">
        From viral hook to community loyalty. 85K+ followers &amp; 4.2M views.
      </div>
    </div>

    <!-- Center Stage Case Card Display -->
    <div class="p-cases__main">

      <!-- Case 01: Social Media -->
      <div class="case-card is-active" data-case="0">
        <div class="case-card__number u-en">Case 01</div>
        <div class="case-card__visual" title="Click to view deep dive">
          <img src="ChatGPT Image Jul 8, 2026, 04_39_44 PM.png" alt="Social Media Growth Engine" class="case-card__img">
        </div>
        <h3 class="case-card__title">Social Media Growth Engine: From Cold Scrollers to 85K+ Engaged Community</h3>
        <p class="case-card__desc">Engineered retention-optimized short-form video hooks, carousel frameworks, and automated DM lead funnels across Instagram and TikTok for international brands and creator channels.</p>
        <div class="case-card__tags">
          <span class="case-tag">Social Media Specialist</span>
          <span class="case-tag">Viral Video Hooks</span>
          <span class="case-tag">85K Followers</span>
        </div>
        <button class="mildsugar-btn" onclick="document.querySelectorAll('.case-card__visual')[0].click()" style="font-size: 20px;">
          <span class="label">
            <span class="label-text">View Case Breakdown [↗]</span>
            <span class="label-text label-text--clone">View Case Breakdown [↗]</span>
          </span>
        </button>
      </div>

      <!-- Case 02: Content Writing -->
      <div class="case-card" data-case="1">
        <div class="case-card__number u-en">Case 02</div>
        <div class="case-card__visual" title="Click to view deep dive">
          <img src="Case 2.png" alt="Conversion Copywriting &amp; Content Architecture" class="case-card__img">
        </div>
        <h3 class="case-card__title">Conversion Copywriting &amp; Content Architecture: Generating 42 Inbound B2B Leads/mo</h3>
        <p class="case-card__desc">Authored authoritative SEO pillar hubs, persuasive landing page copy, and executive LinkedIn thought-leadership essays that position founders as industry authorities.</p>
        <div class="case-card__tags">
          <span class="case-tag">Content Writing</span>
          <span class="case-tag">B2B Strategy</span>
          <span class="case-tag">120K Views/mo</span>
        </div>
        <button class="mildsugar-btn" onclick="document.querySelectorAll('.case-card__visual')[1].click()" style="font-size: 20px;">
          <span class="label">
            <span class="label-text">View Case Breakdown [↗]</span>
            <span class="label-text label-text--clone">View Case Breakdown [↗]</span>
          </span>
        </button>
      </div>

      <!-- Case 03: Graphic Design -->
      <div class="case-card" data-case="2">
        <div class="case-card__number u-en">Case 03</div>
        <div class="case-card__visual" title="Click to view deep dive">
          <img src="Case 3.jpg" alt="Visual Identity &amp; Branding" class="case-card__img">
        </div>
        <h3 class="case-card__title">Visual Identity &amp; High-CTR Creative Kit: Elevating Brand Perception Across 15 Channels</h3>
        <p class="case-card__desc">Designed cohesive brand kits, scroll-stopping social ad creative systems, and investor pitch decks that boosted ad click-through rate by +3.8% across diverse client niches.</p>
        <div class="case-card__tags">
          <span class="case-tag">Graphic Design</span>
          <span class="case-tag">Brand Identity</span>
          <span class="case-tag">Pitch Decks</span>
        </div>
        <button class="mildsugar-btn" onclick="document.querySelectorAll('.case-card__visual')[2].click()" style="font-size: 20px;">
          <span class="label">
            <span class="label-text">View Case Breakdown [↗]</span>
            <span class="label-text label-text--clone">View Case Breakdown [↗]</span>
          </span>
        </button>
      </div>

      <!-- Case 04: Digital Marketing -->
      <div class="case-card" data-case="3">
        <div class="case-card__number u-en">Case 04</div>
        <div class="case-card__visual" title="Click to view deep dive">
          <img src="Professional at a Modern Office Desk.png" alt="Performance Marketing" class="case-card__img">
        </div>
        <h3 class="case-card__title">Full-Funnel Paid Advertising: Slashing CPA by 52% and Scaling ROAS to 4.2x–6.8x</h3>
        <p class="case-card__desc">Restructured Meta and Google Ads accounts with creative fatigue management, lookalike segmentation, and omnichannel cart recovery sequences.</p>
        <div class="case-card__tags">
          <span class="case-tag">Digital Marketing</span>
          <span class="case-tag">Meta Ads</span>
          <span class="case-tag">4.2x ROAS</span>
        </div>
        <button class="mildsugar-btn" onclick="document.querySelectorAll('.case-card__visual')[3].click()" style="font-size: 20px;">
          <span class="label">
            <span class="label-text">View Case Breakdown [↗]</span>
            <span class="label-text label-text--clone">View Case Breakdown [↗]</span>
          </span>
        </button>
      </div>

      <!-- Case 05: Data Entry -->
      <div class="case-card" data-case="4">
        <div class="case-card__number u-en">Case 05</div>
        <div class="case-card__visual" title="Click to view deep dive">
          <img src="21.png" alt="Data Systems & Architecture" class="case-card__img">
        </div>
        <h3 class="case-card__title">Precision Data Entry &amp; Automation: 100% Accuracy Across 25,000+ Records</h3>
        <p class="case-card__desc">Backed by 7+ years of rigorous data management, inventory systems, and spreadsheet architecture with 100% precision across 25,000+ records.</p>
        <div class="case-card__tags">
          <span class="case-tag">Data Entry &amp; Systems</span>
          <span class="case-tag">Excel &amp; Sheets</span>
          <span class="case-tag">100% Accuracy</span>
        </div>
        <button class="mildsugar-btn" onclick="document.querySelectorAll('.case-card__visual')[4].click()" style="font-size: 20px;">
          <span class="label">
            <span class="label-text">View Case Breakdown [↗]</span>
            <span class="label-text label-text--clone">View Case Breakdown [↗]</span>
          </span>
        </button>
      </div>

    </div>

    <!-- Right Side Vertical Dots Navigation (mildsugar signature) -->
    <nav class="p-cases__nav" aria-label="Case Switcher">
      <ul class="p-cases__nav-list">
        <li class="p-cases__nav-item is-current" data-case-index="0">
          <span class="dot"></span> <span>Case 01</span>
        </li>
        <li class="p-cases__nav-item" data-case-index="1">
          <span class="dot"></span> <span>Case 02</span>
        </li>
        <li class="p-cases__nav-item" data-case-index="2">
          <span class="dot"></span> <span>Case 03</span>
        </li>
        <li class="p-cases__nav-item" data-case-index="3">
          <span class="dot"></span> <span>Case 04</span>
        </li>
        <li class="p-cases__nav-item" data-case-index="4">
          <span class="dot"></span> <span>Case 05</span>
        </li>
      </ul>
    </nav>
  </section>

  <!-- Complete 5 Disciplines Showcase -->
  <section class="p-disciplines" id="disciplines">
    <div class="container-boxed">
      <div class="section-head">
        <p class="section-head__tag">DISCIPLINES &amp; CRAFT</p>
        <h2 class="section-head__title">How Thoughtful Strategy Meets High-Impact Execution</h2>
        <p class="section-head__desc">A multi-disciplinary stack allowing you to hire one dedicated specialist instead of juggling 5 different freelancers.</p>
      </div>

      <div class="disciplines-grid">

        <!-- 1. Social Media Specialist -->
        <div class="discipline-box">
          <div>
            <div class="discipline-header">
              <span class="discipline-num">01</span>
              <div class="discipline-icon-badge">📱</div>
            </div>
            <h3>Social Media Specialist</h3>
            <p>Full-service community and content management. Turning passive scrollers into passionate brand advocates across Instagram, TikTok, LinkedIn, and YouTube.</p>
            <ul class="discipline-bullets">
              <li>Viral Reels, TikToks &amp; Short-Form Video Strategy</li>
              <li>Monthly Content Calendars &amp; Community Building</li>
              <li>Brand Reputation &amp; Automated DM Lead Funnels</li>
            </ul>
          </div>
          <div class="discipline-metric">
            <span>AUDIENCE SCALED</span>
            <span>+85K Organic</span>
          </div>
        </div>

        <!-- 2. Content Writing & Strategy -->
        <div class="discipline-box">
          <div>
            <div class="discipline-header">
              <span class="discipline-num">02</span>
              <div class="discipline-icon-badge">✍️</div>
            </div>
            <h3>Content Writing &amp; Strategy</h3>
            <p>Words engineered with conversion psychology and search intent. Crafting persuasive narratives that inform, rank on Google, and drive buying action.</p>
            <ul class="discipline-bullets">
              <li>High-Converting Landing Page &amp; Ad Copywriting</li>
              <li>In-Depth SEO Blog Pillars &amp; Content Hubs</li>
              <li>Executive LinkedIn Thought Leadership Posts</li>
            </ul>
          </div>
          <div class="discipline-metric">
            <span>INBOUND PIPELINE</span>
            <span>42 Leads/mo</span>
          </div>
        </div>

        <!-- 3. Graphic Design & Branding -->
        <div class="discipline-box">
          <div>
            <div class="discipline-header">
              <span class="discipline-num">03</span>
              <div class="discipline-icon-badge">🎨</div>
            </div>
            <h3>Graphic Design &amp; Branding</h3>
            <p>Visual storytelling that stops the scroll. Developing cohesive visual identities, high-CTR social assets, corporate pitch decks, and infographics.</p>
            <ul class="discipline-bullets">
              <li>Complete Brand Guidelines &amp; Typography Systems</li>
              <li>High-CTR Social Media Ad Templates &amp; Carousels</li>
              <li>Investor Pitch Decks &amp; Executive Presentations</li>
            </ul>
          </div>
          <div class="discipline-metric">
            <span>AD CTR IMPROVEMENT</span>
            <span>+3.8% Lift</span>
          </div>
        </div>

        <!-- 4. Digital Marketing & Ads -->
        <div class="discipline-box">
          <div>
            <div class="discipline-header">
              <span class="discipline-num">04</span>
              <div class="discipline-icon-badge">📈</div>
            </div>
            <h3>Digital Marketing &amp; Ads</h3>
            <p>Data-driven paid media management across Meta and Google. Architecting full-funnel acquisition roadmaps that lower CPA and compound revenue.</p>
            <ul class="discipline-bullets">
              <li>Meta Ads (Facebook/Instagram) &amp; Google Search/Display</li>
              <li>Dynamic Retargeting &amp; Omnichannel Cart Recovery</li>
              <li>GA4 Conversion Attribution &amp; KPI Dashboards</li>
            </ul>
          </div>
          <div class="discipline-metric">
            <span>CAMPAIGN ROAS</span>
            <span>4.2x – 6.8x</span>
          </div>
        </div>

        <!-- 5. Data Entry & Systems -->
        <div class="discipline-box">
          <div>
            <div class="discipline-header">
              <span class="discipline-num">05</span>
              <div class="discipline-icon-badge">📊</div>
            </div>
            <h3>Data Entry &amp; Systems</h3>
            <p>Flawless data management and spreadsheet architecture. Ensuring 100% precision in inventory, CRM records, lookup formulas, and executive reports.</p>
            <ul class="discipline-bullets">
              <li>Advanced Excel &amp; Google Sheets (VLOOKUP, Index-Match)</li>
              <li>Database Cleansing, CRM Hygiene &amp; Enrichment</li>
              <li>Automated Dashboards Cutting Manual Work by 80%</li>
            </ul>
          </div>
          <div class="discipline-metric">
            <span>DATA ACCURACY</span>
            <span>100% Precision</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. WHAT I OFFER & PACKAGES (Ahmad Farooq Style) -->
  <section id="offer" class="p-offer">
    <div class="container-boxed">
      <div class="section-head">
        <p class="section-head__tag">PRICING &amp; SCOPE</p>
        <h2 class="section-head__title">Strategic Scope.<br>Transparent, Competitive Pricing.</h2>
        <p class="section-head__desc">Clear deliverables, affordable startup-friendly rates, and full multi-disciplinary execution. No lock-in contracts.</p>
      </div>

      <div class="offer-cards-grid">

        <!-- Package A: Sprint Audit & Setup -->
        <div class="offer-card">
          <div class="offer-card__top">
            <span class="offer-badge">ONE-TIME SPRINT</span>
            <div class="offer-price-wrap">
              <span class="offer-price">$120</span>
              <span class="offer-price-sub">one-off sprint</span>
            </div>
          </div>
          <h3 class="offer-card__title">Social &amp; Brand Growth Audit</h3>
          <p class="offer-card__desc">Complete profile overhaul, hook frameworks, bio rewrite, and content calendar blueprint that turns passive visitors into inbound inquiries.</p>
          
          <div class="offer-deliverables">
            <p class="offer-deliv-head">What You Get:</p>
            <ul class="offer-deliv-list">
              <li><span class="chk">✓</span> High-converting bio &amp; profile positioning rewrite</li>
              <li><span class="chk">✓</span> 30-day viral short-form Reel &amp; TikTok hook scripts</li>
              <li><span class="chk">✓</span> 3 custom social media ad/banner templates (Figma/Canva)</li>
              <li><span class="chk">✓</span> Competitor gap analysis &amp; audience targeting roadmap</li>
            </ul>
          </div>

          <a href="#contact" class="action-btn-pill secondary" style="width: 100%; justify-content: center;">
            <span>Get Started with Audit</span>
          </a>
        </div>

        <!-- Package B: Monthly Full Growth Retainer (Featured) -->
        <div class="offer-card offer-card--featured">
          <div class="offer-card__top">
            <span class="offer-badge offer-badge--featured">MOST POPULAR PARTNERSHIP</span>
            <div class="offer-price-wrap">
              <span class="offer-price offer-price--featured">$350</span>
              <span class="offer-price-sub">per month</span>
            </div>
          </div>
          <h3 class="offer-card__title">All-in-One Monthly Growth Retainer</h3>
          <p class="offer-card__desc">A complete done-for-you organic growth, ad creative, and content pipeline taking the entire digital marketing workload off your plate.</p>
          
          <div class="offer-highlight-pill">
            <span>🔥 Full Multi-Disciplinary Coverage: Social + Ads + Content + Data</span>
          </div>

          <div class="offer-deliverables">
            <p class="offer-deliv-head">Weekly Operations (Monday to Friday):</p>
            <ul class="offer-deliv-list">
              <li><span class="chk">✓</span> 4 to 5 high-retention Reels / Carousels authored &amp; designed weekly</li>
              <li><span class="chk">✓</span> Meta (FB/IG) Ad creative design &amp; audience campaign management</li>
              <li><span class="chk">✓</span> Automated DM &amp; inbound prospect lead qualification funnels</li>
              <li><span class="chk">✓</span> Weekly performance analytics &amp; automated Excel/Sheets report</li>
            </ul>
          </div>

          <a href="#contact" class="action-btn-pill primary" style="width: 100%; justify-content: center;">
            <span>Book Monthly Retainer →</span>
          </a>
        </div>

        <!-- Package C: Custom Systems & Design Retainer -->
        <div class="offer-card">
          <div class="offer-card__top">
            <span class="offer-badge">SYSTEMS &amp; BRANDING</span>
            <div class="offer-price-wrap">
              <span class="offer-price">$220</span>
              <span class="offer-price-sub">per project</span>
            </div>
          </div>
          <h3 class="offer-card__title">Brand Kit &amp; Data Architecture</h3>
          <p class="offer-card__desc">Full visual identity system paired with automated spreadsheet/CRM models for companies scaling operations and pitching investors.</p>
          
          <div class="offer-deliverables">
            <p class="offer-deliv-head">What You Get:</p>
            <ul class="offer-deliv-list">
              <li><span class="chk">✓</span> Complete brand guidelines, typography pairings &amp; color system</li>
              <li><span class="chk">✓</span> 15-slide investor pitch deck / client presentation</li>
              <li><span class="chk">✓</span> Automated Excel / Sheets tracker with dynamic VLOOKUP &amp; dashboards</li>
              <li><span class="chk">✓</span> 100% precision data cleanup &amp; CRM hygiene</li>
            </ul>
          </div>

          <a href="#contact" class="action-btn-pill secondary" style="width: 100%; justify-content: center;">
            <span>Order Systems Kit</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Creative Posters & Brand Graphics Gallery -->
  <section class="p-gallery" id="gallery">
    <div class="container-boxed">
      <div class="section-head">
        <p class="section-head__tag">CREATIVE GALLERY &amp; POSTERS</p>
        <h2 class="section-head__title">Visual Assets &amp; Brand Storytelling</h2>
        <p class="section-head__desc">A selection of visual design assets, advertising creatives, and conceptual artworks crafted for modern campaigns. Click any poster to view in high resolution.</p>
      </div>

      <div class="gallery-grid">

        <!-- Poster 01 -->
        <div class="poster-card" onclick="openLightbox('ChatGPT Image Jul 8, 2026, 04_39_44 PM.png', 'Futuristic Cyber Aesthetics &amp; Social Creative')">
          <div class="poster-img-container">
            <span class="poster-category-tag">Social Creative</span>
            <img src="ChatGPT Image Jul 8, 2026, 04_39_44 PM.png" alt="Futuristic Cyber Aesthetics Poster" loading="lazy">
            <div class="poster-zoom-hint">🔍</div>
          </div>
          <div class="poster-details">
            <div>
              <h3>Futuristic Cyber Aesthetics &amp; Social Creative</h3>
              <p>High-energy visual crafted for tech and digital brand campaigns with atmospheric lighting and contrast.</p>
            </div>
            <div class="poster-footer-meta">
